[Unit]
Description=MyQ software gateway for Broadlink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projects/myq
Environment=PYTHONUNBUFFERED=1
Environment=MYQ_BIND=127.0.0.1
Environment=MYQ_PORT=8766
EnvironmentFile=-/home/pi/bashrc/secure/myq_bridge.env
ExecStart=/home/pi/Projects/py311/bin/myq-cloud serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# The service only needs normal network/filesystem access. Keep credentials in
# the EnvironmentFile and rotating OAuth session in ignored config/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/pi/Projects/myq/config

[Install]
WantedBy=multi-user.target
