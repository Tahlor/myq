# Host-local copy: /etc/myq/myq-cloud.env (mode 0640 or stricter)
MYQ_ENABLE_EXPERIMENTAL_CLOUD=1
MYQ_PROTOCOL_PROFILE=android-5.243.1.73243
MYQ_CLOUD_SESSION=/var/lib/myq/cloud_session.json
MYQ_BIND=127.0.0.1
MYQ_PORT=8766
MYQ_API_KEY=REPLACE_WITH_RANDOM_LOCAL_API_KEY
# Optional: pin a door when an account has multiple garage doors.
# MYQ_DOOR_NAME=Garage Door
# MYQ_DOOR_ID=REPLACE_ONLY_IN_HOST_LOCAL_ENV
