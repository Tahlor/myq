# Copy to /home/pi/bashrc/secure/myq_bridge.env on the Broadlink Pi.
# Never commit the real file or values.

# Local REST authentication shared with the Broadlink service.
MYQ_API_KEY=replace-with-a-long-random-local-key

# Rotating OAuth session file. This file is gitignored by Tahlor/myq.
MYQ_CLOUD_SESSION=/home/pi/Projects/myq/config/cloud_session.json

# Optional only if the account has multiple garage doors.
# Prefer a stable human-readable name; use MYQ_DOOR_ID only when necessary.
# MYQ_DOOR_NAME=Main Garage
# MYQ_DOOR_ID=

# Normally leave these loopback-only defaults as-is.
MYQ_BIND=127.0.0.1
MYQ_PORT=8766
