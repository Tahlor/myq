# EXPERIMENTAL ONLY — not the production Broadlink path.
#
# Community unofficial MyQ cloud integrations have repeatedly broken as
# Chamberlain changed/blocked access. Keep this service only for protocol
# experiments or explicitly validated short-lived tests. Production should use
# the official-app Superbox bridge or a true-local/local-emulator backend.

[Unit]
Description=EXPERIMENTAL MyQ direct-cloud gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Projects/myq
Environment=PYTHONUNBUFFERED=1
Environment=MYQ_BIND=127.0.0.1
Environment=MYQ_PORT=8766
EnvironmentFile=-/home/pi/bashrc/secure/myq_bridge.env
ExecStart=/home/pi/Projects/py311/bin/myq-cloud serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/pi/Projects/myq/config

[Install]
WantedBy=multi-user.target
